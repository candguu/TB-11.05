# TB Trading Bot - Environment Variables
# ========================================

# ZORUNLU DEĞIŞKENLER
# -------------------

# Uygulama güvenlik anahtarı (en az 32 karakter)
SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production

# Admin kullanıcı email adresi
ADMIN_EMAIL=admin@tbot.com

# Admin kullanıcı şifresi (en az 8 karakter)
ADMIN_PASSWORD=your-strong-password-change-this

# OPSIYONEL DEĞIŞKENLER
# ---------------------

# CORS için izin verilen origin'ler (virgülle ayrılmış)
ALLOWED_ORIGINS=http://localhost:5000,https://your-app.onrender.com

# Log seviyesi (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Veritabanı dosya yolu
DB_PATH=./tb_database.db

# Binance API anahtarı (opsiyonel - admin için otomatik bağlanır)
BINANCE_API_KEY=

# Binance API secret (opsiyonel - admin için otomatik bağlanır)
BINANCE_API_SECRET=

# DİĞER AYARLAR
# -------------

# Port numarası (default: 5000)
PORT=5000

# Debug modu (production'da false olmalı)
DEBUG=false

# Email doğrulama zorunluluğu (true/false)
REQUIRE_EMAIL_VERIFICATION=false

# SMTP Ayarları (Email gönderimi için - opsiyonel)
# ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@tbot.com

# GÜVENLİK NOTLARI
# ----------------
# 1. SECRET_KEY'i mutlaka değiştirin ve güçlü bir değer kullanın
# 2. ADMIN_PASSWORD'ü güçlü bir şifre yapın (büyük/küçük harf, sayı, özel karakter)
# 3. Production'da DEBUG=false olmalı
# 4. .env dosyasını asla git'e commit etmeyin
# 5. Her environment için farklı SECRET_KEY kullanın

# PRODUCTION CHECKLIST
# --------------------
# [ ] SECRET_KEY değiştirildi ve 32+ karakter
# [ ] ADMIN_PASSWORD güçlü bir şifre
# [ ] DEBUG=false
# [ ] ALLOWED_ORIGINS production domain'i içeriyor
# [ ] LOG_LEVEL=INFO veya WARNING
# [ ] BINANCE_API_KEY ve SECRET production key'leri
